{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimum the Studio webview needs. No fs, shell, process or open-url access.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-credential-load",
    "allow-credential-save",
    "allow-credential-clear",
    "allow-shell-config",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://xo.example.com/*" }, { "url": "http://127.0.0.1:4000/*" }]
    }
  ]
}
