packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts.map
packages/*/test/**/*.js
packages/*/test/**/*.js.map
packages/*/tests/**/*.js
packages/*/tests/**/*.js.map
apps/*/src/**/*.js
apps/*/src/**/*.js.map
apps/*/test/**/*.js
apps/*/test/**/*.js.map

# Runtime data written by tests and local servers
**/.xo-data/

# Studio local workspace state and generated compile outputs (never source)
.xo-studio/
