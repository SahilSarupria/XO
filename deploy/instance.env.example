# UW-17 — settings for a real (non-local) XO instance run with compose.yaml. Copy to `.env` next to compose.yaml and fill in.
# Every setting is in docs/CONFIGURATION.md; `docker compose run --rm xo xo config check` checks them without starting.
# Secrets (model keys, OAuth client secret, metrics token) do NOT go here: use `xo secrets set NAME` inside the container.

NODE_ENV=production
XO_ENV=production

# The address people use (https). Its /auth/callback is the sign-in return address to register with your identity provider.
XO_PUBLIC_BASE_URL=https://xo.example.com

# Package trust: verify package signatures against your trust policy (mount the file into the container, e.g. ./trust:/trust:ro).
XO_TRUST_MODE=enforce
XO_PACKAGE_TRUST_POLICY=/trust/policy.json

# Audit retention, in days. The platform audit store lives in the data directory; anchors on their own volume (/anchors).
XO_AUDIT_RETENTION_DAYS=400
XO_AUDIT_MIN_RETENTION_DAYS=365
XO_API_AUDIT_RETENTION_DAYS=400

# Where data may go when a model is asked something (docs/RESIDENCY.md). strict_local: models on this server only (default).
# masked_hosted: also hosted providers you have a paid, no-training contract with, for typed requests only. open is refused here.
XO_RESIDENCY=strict_local
# XO_HOSTED_MODEL_PROVIDERS=anthropic

# Sign-in for your people: Google (docs/studio/GOOGLE_SIGNIN_RUNBOOK.md) and/or password. Hide the access-key sign-in once one works.
# XO_API_GOOGLE_CLIENT_ID=
# XO_API_PASSWORD_AUTH=1
# XO_DEV_SIGN_IN=0

# Number of reverse proxies you operate in front of the instance (the TLS terminator), so rate limits see real client addresses.
XO_API_TRUSTED_PROXY_HOPS=1

# Where compose publishes the port on the host (keep it on loopback behind your proxy).
XO_PORT=4000
