{
  "name": "@xo/compiler",
  "version": "0.1.0",
  "private": true,
  "description": "The first real Experience Compiler frontend: PDF -> Corporate Contract Lawyer XOIR graph. Implements @xo/compiler-core's Compiler interface. No external runtime dependencies — PDF parsing is pure Node (built-in zlib only).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "node ../../scripts/run-tests.mjs test",
    "test:coverage": "node ../../scripts/run-tests.mjs --coverage test"
  },
  "dependencies": {
    "@xo/ai-core": "0.1.0",
    "@xo/capability-contract": "0.1.0",
    "@xo/compiler-core": "0.1.0",
    "@xo/crypto": "0.1.0",
    "@xo/errors": "0.1.0",
    "@xo/logger": "0.1.0",
    "@xo/package-sdk": "0.1.0",
    "@xo/permissions": "0.1.0",
    "@xo/types": "0.1.0",
    "@xo/xoir": "0.1.0"
  },
  "devDependencies": {
    "@xo/workflow-composer": "0.1.0",
    "tsx": "^4.16.0"
  },
  "optionalDependencies": {
    "@hyzyla/pdfium": "^3.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "tesseract.js": "^7.0.0"
  }
}
