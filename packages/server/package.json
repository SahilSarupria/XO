{
  "name": "@xo/server",
  "version": "0.1.0",
  "private": true,
  "description": "Local HTTP API for the XO workflow runner: runs, approvals, loader resolution, receipts, leases and ledger sync. Localhost-bound, token-authenticated, no UI.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "node ../../scripts/run-tests.mjs test"
  },
  "dependencies": {
    "@xo/capability-layer": "0.1.0",
    "@xo/workflow-ir": "0.1.0",
    "@xo/workflow-runtime": "0.1.0",
    "@xo/package-sdk": "0.1.0",
    "@xo/types": "0.1.0"
  },
  "devDependencies": {
    "tsx": "^4.16.0"
  }
}
