// Reproducible compile-time evidence for one real document. Usage: npx tsx e2e-evidence.mts <path-to-pdf> [out.md]
// It reports what the COMPILER established (understanding, states, blockers). It does not execute rules at runtime; the
// benchmark package's real-pipeline cases (vertical-fixtures) do that, and run in that package's own test suite.
import { writeFileSync } from 'node:fs';
import { collectSources } from '../../../apps/cli/dist/commands/compiler/source-collection.js';
import { compileSources } from '@xo/compiler';

const file = process.argv[2]!;
const c = await collectSources([file]);
const r: any = await compileSources(c.inputs as any, {});
if (!r.ok) { console.error(r.error.message); process.exit(1); }
const v = r.value; const er = v.executionReadiness;
const by = (k: string) => er.entries.filter((e: any) => `${e.compilerState}/${e.executionState}` === k).length;
const lines: string[] = [];
const L = (s = '') => lines.push(s);

L(`# End-to-end compile evidence: ${file.split('/').pop()}`);
L(); L('Generated by `e2e-evidence.mts` from the real document. Compile-time readiness only: no rule is executed here.');
L(); L('## Pipeline');
L(`- Source: ${v.sources.map((s: any) => `${s.sourceType}, ${s.unitCount} unit(s)`).join('; ')}`);
L(`- Domain: ${(v.diagnostics.find((d: any) => d.code.startsWith('domain/')) ?? { message: 'n/a' }).message.slice(0, 220)}`);
L(`- Rules: ${er.entries.length} typed rule nodes; compiler state: ${JSON.stringify(er.summary.byCompilerState)}; execution state: ${JSON.stringify(er.summary.byExecutionState)}`);
L(`- Cross-document: ${v.crossDocument.conflicts.length} conflict(s), ${v.crossDocument.amendments.length} amendment cue(s)`);
L(`- Review queue: ${v.reviewQueue.items.length} item(s) by priority ${JSON.stringify(v.reviewQueue.summary.byPriority)}`);
L(`- Sentences judged normative but not extracted: ${v.diagnostics.filter((d: any) => d.code === 'coverage/normative-sentence-not-extracted').length}`);

L(); L('## Appendix A cases (from the document) against the rules that govern them');
const cases: [string, string, RegExp][] = [
  ['A', 'claim_amount = INR 15,000; policy active; documents complete -> manager approval required', /claim amount|manager approval/i],
  ['B', 'claim_amount = INR 5,000; policy active; documents complete -> manager approval not required', /claim amount|manager approval/i],
  ['C', 'claim_amount = INR 150,000; covered loss -> manager and loss-adjuster assessment', /loss-adjuster|claim amount/i],
  ['D', 'loss_type = flood; no flood endorsement -> denied / excluded', /flood/i],
  ['E', 'loss_type = theft; police report absent -> cannot reach final settlement', /police|theft/i],
  ['F', 'notification = 5 days after loss -> notification requirement satisfied', /notification|7 (calendar )?days/i],
  ['G', 'notification = 12 days after loss -> standard notification requirement not satisfied', /notification|7 (calendar )?days/i],
  ['H', 'policy expired before loss -> coverage review / not covered under standard rule', /expired|policy period|active policy/i],
];
for (const [id, text, re] of cases) {
  L(); L(`### Case ${id}: ${text}`);
  const hits = er.entries.filter((e: any) => re.test(`${e.condition ?? ''} ${e.label}`)).slice(0, 6);
  if (hits.length === 0) { L('- No rule node matched: this case is NOT covered by any extracted rule (see the review queue).'); continue; }
  for (const e of hits) L(`- [${e.compilerState} / ${e.executionState}] ${String(e.label).slice(0, 110)}${e.blockers.length ? `  — blockers: ${e.blockers.join('; ').slice(0, 140)}` : ''}${e.requiredInputs.length ? `  — inputs: ${e.requiredInputs.join(', ')}` : ''}`);
}
L(); L('## What a person still has to do'); 
for (const i of v.reviewQueue.items.slice(0, 15)) L(`- (P${i.priority}) ${i.kind}: ${i.summary.slice(0, 140)}`);
if (v.reviewQueue.items.length > 15) L(`- ... and ${v.reviewQueue.items.length - 15} more (priority 3 items are informational).`);
writeFileSync(process.argv[3] ?? 'e2e-evidence-real-policy.md', lines.join('\n') + '\n');
console.log(lines.slice(0, 12).join('\n'));
