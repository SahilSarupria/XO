{
  "name": "@xo/connectors",
  "version": "0.1.0",
  "private": true,
  "description": "Connector framework for XO workflows: capability grants, dry-run, secret vault with redaction, and built-in HTTP and file connectors. Everything returned by an external system is marked untrusted.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "node ../../scripts/run-tests.mjs test",
    "test:coverage": "node ../../scripts/run-tests.mjs --coverage test"
  },
  "dependencies": {
    "@xo/workflow-ir": "0.1.0"
  },
  "devDependencies": {
    "tsx": "^4.16.0"
  }
}
