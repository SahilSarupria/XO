{
  "name": "@xo/instance",
  "version": "0.1.0",
  "private": true,
  "description": "One XO instance: its settings (validated at start-up), its single data directory, secrets, metadata and migrations, the single-runner lock, and lifecycle operations (backup, restore, upgrade, verified erasure).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "node ../../scripts/run-tests.mjs test",
    "test:coverage": "node ../../scripts/run-tests.mjs --coverage test"
  },
  "dependencies": {},
  "devDependencies": {
    "tsx": "^4.16.0"
  }
}
