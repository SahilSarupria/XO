{
  "name": "@xo/workflow-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Durable, resumable runner for Workflow IR 1.0: hash-chained on-disk journal, at-most-once acceptance, idempotent external calls, retries with backoff, per-connector circuit breakers, compensation, authority ceilings, dry-run.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "node ../../scripts/run-tests.mjs test",
    "test:coverage": "node ../../scripts/run-tests.mjs --coverage test"
  },
  "dependencies": {
    "@xo/ai-core": "0.1.0",
    "@xo/capability-layer": "0.1.0",
    "@xo/connectors": "0.1.0",
    "@xo/workflow-ir": "0.1.0"
  },
  "devDependencies": {
    "tsx": "^4.16.0"
  }
}
