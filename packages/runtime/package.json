{
  "name": "@xo/runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Runtime Stage 1: package mounting & execution pipeline. Discovers, verifies, and mounts installed XO packages, exposes their declared capabilities through a registry, and deterministically plans (never executes) requests against them. Not prompt assembly, retrieval, memory, or AI provider calls — see later runtime stages.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:coverage": "node --import tsx --experimental-test-coverage --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@xo/types": "0.1.0",
    "@xo/errors": "0.1.0",
    "@xo/storage": "0.1.0",
    "@xo/logger": "0.1.0",
    "@xo/observability": "0.1.0",
    "@xo/package-sdk": "0.1.0",
    "@xo/ai-core": "0.1.0",
    "@xo/permissions": "0.1.0",
    "@xo/capability-contract": "0.1.0",
    "@xo/xoir": "0.1.0",
    "@xo/workflow-composer": "0.1.0"
  },
  "devDependencies": {
    "@xo/testing": "0.1.0",
    "@xo/compiler": "0.1.0",
    "tsx": "^4.16.0"
  }
}
