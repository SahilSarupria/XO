{
  "name": "@xo/atlas",
  "version": "0.1.0",
  "private": true,
  "description": "The interaction engine for XO. Depth instead of navigation. Understanding instead of pages. Space instead of menus.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/tests/*.test.js",
    "bench": "tsc -p tsconfig.test.json && node dist-test/bench/bench.js",
    "clean": "rm -rf dist dist-test"
  },
  "devDependencies": {
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=18"
  }
}
