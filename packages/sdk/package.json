{
  "name": "@xo/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Typed client for the XO local HTTP API (runs, approvals, loader resolution, receipts, leases, ledger sync). Backend only.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
