# XO local development settings.
# `npm run setup` copies this to `.env` for you. `.env` is git-ignored: never commit real secrets.
# Every value below is optional; the defaults shown are what XO uses when a line is missing.

# ---- API (apps/api) ---------------------------------------------------------
# Port and address the API listens on. Keep HOST=127.0.0.1 unless you know you need otherwise.
PORT=4000
HOST=127.0.0.1

# Where the dev API keeps its data. `npm run dev` uses ./.xo-dev (safe to delete to start fresh).
# API_KEYS_DIR=.xo-dev/keys
# WORKSPACES_DIR=.xo-dev/workspaces
# WORKSPACE_DATA_DIR=.xo-dev/workspace-data

# ---- Studio (apps/studio) ---------------------------------------------------
# Port for the Studio dev server, and where it forwards /api requests.
STUDIO_PORT=5173
# XO_API_URL=http://127.0.0.1:4000

# ---- Sign-in with an organisation account (optional) ------------------------
# Leave unset for local development: Studio then offers the "Development sign-in" (access key).
# The key is printed by `npm run dev` and saved to .xo-dev/dev-key.txt.
# For Google sign-in see docs/studio/GOOGLE_SIGNIN_RUNBOOK.md for the full list of variables.
