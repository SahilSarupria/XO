# Placeholders only. Copy to .env (git-ignored) and fill in locally. Never commit real keys.
# Server-side only: never expose GEMINI_API_KEY to browser code, Studio bundles, CLI output or logs.

# XO_ENV=development            # development | test | production
# XO_INFERENCE_PROVIDER=gemini  # none (default) | gemini
# GEMINI_API_KEY=your-key-here  # https://aistudio.google.com/apikey
# XO_GEMINI_MODEL=gemini-3.5-flash-lite
# XO_GEMINI_TIMEOUT_MS=30000
# XO_GEMINI_MAX_OUTPUT_TOKENS=8192
# XO_GEMINI_TEMPERATURE=
# XO_GEMINI_MAX_RETRIES=2       # 0 disables retries (defaults to 0 when XO_ENV=test)
# XO_GEMINI_ACK_DATA_USE_TERMS=false  # must be true when XO_ENV=production
