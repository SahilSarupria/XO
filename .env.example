# XO local development settings.
# `npm run setup` copies this to `.env` for you. `.env` is git-ignored: never commit real secrets.
# Every value below is optional; the defaults shown are what XO uses when a line is missing.

# ---- API (apps/api) ---------------------------------------------------------
# Port and address the API listens on. Keep HOST=127.0.0.1 unless you know you need otherwise.
PORT=4000
HOST=127.0.0.1

# UW-17 — one instance data directory (`xo up` defaults to ~/.xo/instances/default). Every storage folder below defaults to a
# folder inside it; all settings are listed in docs/CONFIGURATION.md and checked with `xo config check`.
# XO_DATA_DIR=
# Serve a built Studio on the same port (/ Studio, /api the API). `xo up` uses apps/studio/dist.
# XO_STUDIO_DIR=apps/studio/dist
# The address people use; https except on loopback. Its /auth/callback is an accepted sign-in return address.
# XO_PUBLIC_BASE_URL=http://127.0.0.1:4000
# Bearer token for GET /metrics (Prometheus). Unset: metrics are off. Prefer `xo secrets set XO_METRICS_TOKEN`.
# XO_METRICS_TOKEN=
# debug | info | warn | error (JSON lines on standard output)
# XO_LOG_LEVEL=info
# Where the key to the encrypted secrets file lives: never inside the data directory.
# XO_SECRETS_KEY_FILE=

# Where the dev API keeps its data. `npm run dev` uses ./.xo-dev (safe to delete to start fresh).
# API_KEYS_DIR=.xo-dev/keys
# WORKSPACES_DIR=.xo-dev/workspaces
# WORKSPACE_DATA_DIR=.xo-dev/workspace-data

# ---- Studio (apps/studio) ---------------------------------------------------
# Port for the Studio dev server, and where it forwards /api requests.
STUDIO_PORT=5173
# XO_API_URL=http://127.0.0.1:4000

# ---- Sign-in with an organisation account (optional) ------------------------
# Leave unset for local development: Studio then offers the "Development sign-in" (access key).
# The key is printed by `npm run dev` and saved to .xo-dev/dev-key.txt.
# For Google sign-in see docs/studio/GOOGLE_SIGNIN_RUNBOOK.md for the full list of variables.

# ---- Desktop app: `npm run desktop` reads this file, so you configure once -------
# Google sign-in (optional). Set ALL THREE lines, or none. `npm run desktop` then picks the Google-enabled dev config.
#   XO_OIDC_CLIENT_ID is your Google "Desktop app" OAuth client id: public.
#   XO_API_GOOGLE_CLIENT_SECRET is that same client's secret (Google Cloud Console > Credentials). It is read by the API
#   ONLY, which redeems the sign-in code at Google; the desktop app never receives it and customers never need one.
#   Keep it in this git-ignored file locally, and in a secret manager in production. Never commit it.
# XO_OIDC_ISSUER=https://accounts.google.com
# XO_OIDC_CLIENT_ID=your-client-id.apps.googleusercontent.com
# XO_API_GOOGLE_CLIENT_SECRET=
# Let anyone with a verified Google account sign in; each new person gets their own private organisation.
# Off by default (then an operator must bind each account). Never reuses a revoked account.
# XO_API_SELF_SIGNUP=1
# Most new self-created accounts per rolling 24 hours (default 200). Existing users are never blocked by it.
# XO_API_SELF_SIGNUP_MAX_PER_DAY=200
# Number of reverse proxies you control in front of the API (0-5, default 0), so rate limits see each customer's real address.
# XO_API_TRUSTED_PROXY_HOPS=0
# Hide the development access-key sign-in (only once another sign-in works):
# XO_DEV_SIGN_IN=0

# UW-14 — where data may go when a model is asked something (docs/RESIDENCY.md). Default strict_local: hosted models (Anthropic,
# OpenAI, Gemini, Azure) are never called; use a local Ollama. For development with TEST data only, open allows any provider.
# XO_RESIDENCY=strict_local
# masked_hosted: contracted hosted providers, typed requests only (schemas, synthetic records, filtered intent).
# XO_HOSTED_MODEL_PROVIDERS=anthropic

# Placeholders only. Copy to .env (git-ignored) and fill in locally. Never commit real keys.
# Server-side only: never expose GEMINI_API_KEY to browser code, Studio bundles, CLI output or logs.

# XO_ENV=development            # development | test | production
# XO_INFERENCE_PROVIDER=gemini  # none (default) | gemini
# GEMINI_API_KEY=your-key-here  # https://aistudio.google.com/apikey
# XO_GEMINI_MODEL=gemini-3.5-flash-lite
# XO_GEMINI_TIMEOUT_MS=30000
# XO_GEMINI_MAX_OUTPUT_TOKENS=8192
# XO_GEMINI_TEMPERATURE=
# XO_GEMINI_MAX_RETRIES=2       # 0 disables retries (defaults to 0 when XO_ENV=test)
# XO_GEMINI_ACK_DATA_USE_TERMS=false  # must be true when XO_ENV=production

# UW-1 — maximum age (days) of an API key issued without an expiry (keys issued before UW-1). New keys always carry an expiry
# (scripts/manage-keys.ts, default 90 days). Default 365; 1-3650.
# XO_API_KEY_MAX_AGE_DAYS=365

# UW-1 — where each workspace audit log's chain head is anchored after every append (absolute path). Put it on storage this host
# cannot rewrite (a separate volume, a backup target, object storage with a retention lock). Unset = unanchored: verify then cannot
# detect a complete, consistent rewrite of a log, and production startup logs a warning.
# XO_AUDIT_ANCHOR_DIR=/var/lib/xo-audit-anchors
# Declared retention (days) of workspace audit logs. Unset = none declared, and nothing may be purged. With it set, an operator holding
# the audit.purge grant may purge older entries (POST /audit/workspaces/:id/purge); every purge is recorded in the log it purges.
# XO_API_AUDIT_RETENTION_DAYS=
# UW-1 — approvals and membership changes need a sign-in from the last N minutes (session sign-in time or the OIDC token's auth_time).
# Default 15; 0 turns step-up off; 1-1440. API keys are not asked to step up.
# XO_API_STEP_UP_MAX_AGE_MINUTES=15

# UW-3 — reading scanned pages and photos (docs/INGESTION.md). local (default): a second PDF reader, then OCR on this machine; nothing
# leaves it. off: no reading; such pages stay unaccounted. Workers 1-16, default 2.
# XO_OCR=local
# XO_OCR_WORKERS=2
# Vision reading, only where local reading fell short. Needs ALL of: a provider configured above, a model, the explicit confirmation
# that page images and photos are sent to that provider, and a per-document budget (default 0 = never called; 0-100).
# XO_OCR_VISION_PROVIDER=anthropic
# XO_OCR_VISION_MODEL=
# XO_OCR_VISION_SENDS_IMAGES=yes
# XO_OCR_MAX_COST_USD=0.25
