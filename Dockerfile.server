# Server runner for XO workflows (the backup runner in the local-first / server-backup design).
# Build:  docker build -f Dockerfile.server -t xo-server .
# Run:    docker run --rm -p 127.0.0.1:7433:7433 \
#           -e XO_SERVER_TOKEN="$(openssl rand -hex 32)" \
#           -v "$PWD/data:/data" -v "$PWD/config:/config:ro" xo-server
# The API has no TLS. Publish the port on loopback only, or put a TLS-terminating proxy in front. Never expose it directly.
FROM node:22-bookworm-slim AS build
WORKDIR /workspace
COPY package.json package-lock.json* tsconfig.base.json tsconfig.json ./
COPY packages ./packages
COPY apps ./apps
RUN npm ci --ignore-scripts && npm run build

FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /workspace
COPY --from=build /workspace /workspace
RUN useradd --system --uid 10001 --no-create-home xo && mkdir -p /data && chown xo /data
USER xo
VOLUME ["/data"]
EXPOSE 7433
# Inside a container the process must listen on 0.0.0.0 for the published port to work; --allow-remote acknowledges that.
ENTRYPOINT ["node", "apps/cli/bin/xo.js", "serve", "--runs", "/data/runs", "--host", "0.0.0.0", "--allow-remote", "--port", "7433"]
CMD ["--workflows", "/config/workflows.json", "--policy", "/config/policy.json"]
